# ──────────────────────────── Flux server ────────────────────────────
PORT=4000

# MongoDB connection string.
#  • Local mongod   : mongodb://127.0.0.1:27017/flux
#  • MongoDB Atlas  : mongodb+srv://user:pass@cluster.mongodb.net/flux
# If this is empty (or unreachable) Flux falls back to an in-memory
# MongoDB so the project is demoable with nothing installed.
MONGODB_URI=mongodb://127.0.0.1:27017/flux

# Force the in-memory MongoDB even if MONGODB_URI is reachable.
USE_MEMORY_DB=false

# ──────────────────────────── Alerting ───────────────────────────────
# How often the worker evaluates every site (cron, 6 fields = with seconds).
# Keep this equal to ALERT_WINDOW_SECONDS so the checks are contiguous and a
# short spike cannot slip between two evaluations.
ALERT_CRON=*/4 * * * * *

# Rolling window (seconds) whose request_count is summed and compared
# against each site's alert_threshold. Matches the dashboard's bucket width,
# so the threshold line on the chart means exactly what it says.
ALERT_WINDOW_SECONDS=4

# Do not re-fire an alert for the same site within this many seconds.
ALERT_COOLDOWN_SECONDS=300

# ──────────────────────────── Twilio (optional) ──────────────────────
# Leave TWILIO_ACCOUNT_SID empty to run in dry-run mode: alerts are still
# stored and printed to the console, but no SMS is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ──────────────────────────── Optional ───────────────────────────────
# If set, POST /api/sites requires header `x-admin-token: <value>`.
ADMIN_TOKEN=

# Default phone number used by `npm run seed` (E.164, e.g. +919876543210).
DEMO_PHONE_NUMBER=

# Set to false to stop the server auto-creating a demo site on an empty DB.
AUTOSEED=true
